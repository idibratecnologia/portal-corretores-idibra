# ─────────────────────────────────────────────────────────────────
# FRONTEND — Portal de Corretores IDIBRA
# Copie este arquivo para .env.local e preencha com seus valores.
# ─────────────────────────────────────────────────────────────────

# URL base da API REST (backend Fastify na VPS)
VITE_API_URL=https://api.corretoridibra.com.br

# true  → usa dados mock locais (desenvolvimento sem backend)
# false → chama a API real (produção ou testes integrados)
VITE_USE_MOCK=true
