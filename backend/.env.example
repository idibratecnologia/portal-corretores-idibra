# ─────────────────────────────────────────────────────────────────
# API REST — IDIBRA
# Copie para .env e preencha com valores reais. Nunca comite o .env.
# ─────────────────────────────────────────────────────────────────

# Ambiente
NODE_ENV=development          # development | production

# Servidor
PORT=3000

# ── Banco de Dados ───────────────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://idibra:SuaSenha@localhost:5432/idibra_db

# ── Autenticação JWT ─────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=substitua-por-chave-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=./uploads                 # Em produção: /var/www/uploads
UPLOAD_MAX_SIZE_MB=10
API_URL=http://localhost:3000        # Em produção: https://api.idibra.com.br

# ── Evolution API (WhatsApp) ─────────────────────────────────────
# Deixe em branco para desabilitar disparos de WhatsApp
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=idibra

# ── CORS ─────────────────────────────────────────────────────────
# Origins separados por vírgula
ALLOWED_ORIGINS=http://localhost:5173,https://portal.idibra.com.br
