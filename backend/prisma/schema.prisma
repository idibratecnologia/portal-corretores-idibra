// ─────────────────────────────────────────────────────────────────
// Prisma Schema — Portal de Corretores IDIBRA
// Documentação: https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum StatusCorretor {
  pendente   // Aguardando aprovação do admin
  ativo      // Aprovado e ativo
  bloqueado  // Bloqueado pelo admin
}

enum StatusImobiliaria {
  ativa
  inativa
}

enum StatusEvento {
  rascunho   // Criado mas não visível para corretores
  publicado  // Visível e com inscrições abertas (se inscricoes_abertas=true)
  encerrado  // Finalizado — não aceita mais inscrições
  cancelado  // Cancelado — inscrições são notificadas via WhatsApp
}

enum StatusInscricao {
  inscrito   // Inscrição confirmada, aguardando o evento
  presente   // Check-in realizado
  ausente    // Não compareceu (marcado manualmente pelo admin)
  cancelado  // Inscrição cancelada pelo corretor ou admin
}

enum TipoEvento {
  lancamento   // Lançamento de imóvel
  treinamento  // Capacitação / curso
  reuniao      // Reunião de parceiros
  feira        // Feira imobiliária
  workshop     // Workshop / oficina
  outro
}

enum NivelAdmin {
  super     // Acesso total: excluir, logs e gerenciar usuários
  operador  // Quase tudo (criar/editar/ver), sem excluir/logs/usuários
}

// ─── Admin ────────────────────────────────────────────────────────

model Admin {
  id         String     @id @default(uuid())
  nome       String
  email      String     @unique
  senha      String     // Armazenado como bcrypt hash (salt rounds: 12)
  nivel      NivelAdmin @default(operador)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@map("admins")
}

// ─── Imobiliária ─────────────────────────────────────────────────

model Imobiliaria {
  id         String            @id @default(uuid())
  nome       String
  cnpj       String            @unique @db.VarChar(18) // formatado: 00.000.000/0001-00
  telefone   String?
  email      String?
  cidade     String
  uf         String            @db.Char(2)
  logo_url   String?
  status     StatusImobiliaria @default(ativa)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  corretores Corretor[]

  @@map("imobiliarias")
}

// ─── Corretor ────────────────────────────────────────────────────

model Corretor {
  id                String         @id @default(uuid())
  nome              String
  cpf               String         @unique @db.VarChar(14)  // formatado: 000.000.000-00
  creci             String         @unique
  email             String         @unique
  senha             String         // bcrypt hash — definida no cadastro ou gerada e enviada por WhatsApp
  senha_provisoria  Boolean        @default(false)  // true = precisa trocar no 1º acesso (ex.: importados com CPF)
  telefone          String
  whatsapp          String
  whatsapp_opt_in   Boolean        @default(false)   // LGPD: consentiu receber notificações (WhatsApp)
  email_opt_in      Boolean        @default(true)    // LGPD: receber e-mails de marketing (descadastrável)
  instagram         String?
  data_nascimento   DateTime?      // Aniversário do corretor
  cidade            String
  uf                String         @db.Char(2)
  status            StatusCorretor @default(pendente)
  foto_url          String?        // Caminho relativo: /uploads/fotos/{uuid}.webp
  observacoes_admin String?        // Visível apenas para admins

  imobiliaria_id    String?
  imobiliaria       Imobiliaria?   @relation(fields: [imobiliaria_id], references: [id], onDelete: SetNull)

  inscricoes        Inscricao[]
  notificacoes      NotificacaoLog[]
  convites          EventoConvidado[]
  progresso_aulas        AulaProgresso[]

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@index([status])
  @@index([imobiliaria_id])
  @@map("corretores")
}

// ─── Evento ──────────────────────────────────────────────────────

model Evento {
  id                 String       @id @default(uuid())
  titulo             String
  descricao          String
  tipo               TipoEvento
  empreendimento     String?      // Empreendimento vinculado ao lançamento
  local              String       // Nome do local (ex: "Sede IDIBRA")
  endereco           String       // Endereço completo
  link_maps          String?      // Link do Google Maps
  data_evento        DateTime     // Data e hora de início
  hora_inicio        String       @db.VarChar(5)  // "09:00"
  hora_fim           String       @db.VarChar(5)  // "18:00"
  carga_horaria      Float?       // Carga horária do evento, em horas (ex.: 4, 1.5)
  capacidade         Int          // Número máximo de participantes
  banner_url         String?      // Caminho relativo: /uploads/banners/{uuid}.webp
  status             StatusEvento @default(rascunho)
  inscricoes_abertas Boolean      @default(true)
  certificados_habilitados Boolean @default(false)  // Admin libera a emissão de certificados
  enviar_certificado_auto  Boolean @default(false)  // Enviar certificado por WhatsApp ao encerrar o evento
  certificados_enviados_em DateTime?                 // Carimbo do envio automático (idempotência)
  exclusivo          Boolean      @default(false)   // Visível/notificado só para corretores convidados

  inscricoes         Inscricao[]
  notificacoes       NotificacaoLog[]
  materiais          EventoMaterial[]
  convidados         EventoConvidado[]
  treinamentos       TreinamentoEvento[]
  modelos            EventoModelo[]

  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  @@index([status])
  @@index([data_evento])
  @@map("eventos")
}

// ─── Material de Evento (arquivo ou link) ────────────────────────

enum TipoMaterial {
  arquivo
  link
}

model EventoMaterial {
  id         String       @id @default(uuid())
  tipo       TipoMaterial
  titulo     String
  url        String       // /uploads/materiais/{uuid}.ext (arquivo) ou URL externa (link)

  evento_id  String
  evento     Evento       @relation(fields: [evento_id], references: [id], onDelete: Cascade)

  created_at DateTime     @default(now())

  @@index([evento_id])
  @@map("evento_materiais")
}

// ─── Inscrição ───────────────────────────────────────────────────

model Inscricao {
  id             String          @id @default(uuid())
  status         StatusInscricao @default(inscrito)
  qr_code_token  String          @unique @default(uuid()) // UUID usado para gerar o QR Code
  checkin_at     DateTime?       // Timestamp do check-in
  checkin_por    String?         // ID do admin que realizou o check-in (auditoria)

  corretor_id    String
  evento_id      String
  corretor       Corretor        @relation(fields: [corretor_id], references: [id], onDelete: Cascade)
  evento         Evento          @relation(fields: [evento_id], references: [id], onDelete: Cascade)

  created_at     DateTime        @default(now())

  // Um corretor não pode se inscrever duas vezes no mesmo evento
  @@unique([corretor_id, evento_id])
  @@index([evento_id])
  @@index([status])
  @@map("inscricoes")
}

// ─── Log de Notificações WhatsApp ────────────────────────────────

model NotificacaoLog {
  id          String    @id @default(uuid())

  // Tipo do disparo para auditoria e controle de duplicatas
  // Valores: inscricao_confirmada | lembrete_d1 | lembrete_d0 |
  //          aprovacao | checkin | cancelamento_evento
  tipo        String

  canal       String    @default("whatsapp")  // whatsapp | email
  status      String    // enviado | erro
  mensagem    String?   // Texto enviado (auditoria e reenvio)
  erro        String?   // Mensagem de erro se o disparo falhou

  corretor_id String
  evento_id   String?
  corretor    Corretor  @relation(fields: [corretor_id], references: [id], onDelete: Cascade)
  evento      Evento?   @relation(fields: [evento_id], references: [id], onDelete: SetNull)

  enviado_at  DateTime  @default(now())

  @@index([corretor_id])
  @@index([tipo, status])
  @@index([canal])
  @@index([enviado_at])
  @@map("notificacoes_log")
}

// ─── Convidados de evento exclusivo ──────────────────────────────

model EventoConvidado {
  id          String   @id @default(uuid())
  evento_id   String
  corretor_id String
  evento      Evento   @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  corretor    Corretor @relation(fields: [corretor_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([evento_id, corretor_id])
  @@index([corretor_id])
  @@map("evento_convidados")
}

// ─── Treinamentos ────────────────────────────────────────────────

enum StatusVideo {
  pendente
  upload_recebido
  processando
  disponivel
  erro_processamento
  expirado
  excluido
}

enum StatusProgresso {
  nao_iniciado
  em_andamento
  concluido
}

// Treinamento = trilha/curso (container). Os vídeos ficam nas AULAS.
model Treinamento {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String   @default("")
  ativo       Boolean  @default(true)
  obrigatorio Boolean  @default(false)

  // Se true: cada aula só libera após o corretor concluir a anterior.
  // Se false: cada aula usa a sua própria data_liberacao.
  liberacao_sequencial Boolean @default(false)

  aulas      TreinamentoAula[]
  documentos TreinamentoDocumento[]
  eventos    TreinamentoEvento[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ativo])
  @@map("treinamentos")
}

// Aula = um vídeo do treinamento (armazenado em storage privado).
model TreinamentoAula {
  id             String      @id @default(uuid())
  treinamento_id String
  treinamento    Treinamento @relation(fields: [treinamento_id], references: [id], onDelete: Cascade)

  titulo    String
  descricao String  @default("")
  ordem     Int     @default(0)

  // Vídeo (servido por rota protegida; original mantido até processar)
  video_path    String?       // treinamentos/{tid}/aulas/{aid}/video/720p.mp4
  original_path String?       // original aguardando/while processando (p/ recuperação da fila)
  video_duracao Int?          // segundos (ffprobe)
  thumbnail_url String?       // URL pública
  status_video  StatusVideo   @default(pendente)
  video_erro    String?

  // Liberação por data (quando NÃO sequencial) e encerramento
  data_liberacao    DateTime?
  data_encerramento DateTime?

  // Exclusão automática do vídeo após o encerramento
  excluir_video_automaticamente Boolean   @default(false)
  dias_para_exclusao            Int?
  data_exclusao_video           DateTime?
  video_excluido                Boolean   @default(false)

  progressos AulaProgresso[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([treinamento_id])
  @@map("treinamento_aulas")
}

model TreinamentoDocumento {
  id             String      @id @default(uuid())
  treinamento_id String
  treinamento    Treinamento @relation(fields: [treinamento_id], references: [id], onDelete: Cascade)
  titulo         String
  path           String      // caminho relativo no storage privado
  created_at     DateTime    @default(now())

  @@index([treinamento_id])
  @@map("treinamento_documentos")
}

model TreinamentoEvento {
  id             String      @id @default(uuid())
  treinamento_id String
  evento_id      String
  treinamento    Treinamento @relation(fields: [treinamento_id], references: [id], onDelete: Cascade)
  evento         Evento      @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  ordem          Int         @default(0)
  obrigatorio    Boolean?    // override no contexto do evento (null = usa o do treinamento)
  created_at     DateTime    @default(now())

  @@unique([treinamento_id, evento_id])
  @@index([evento_id])
  @@map("treinamento_eventos")
}

// Progresso por AULA por corretor (1 registro único por aula+corretor).
model AulaProgresso {
  id          String          @id @default(uuid())
  aula_id     String
  corretor_id String
  aula        TreinamentoAula @relation(fields: [aula_id], references: [id], onDelete: Cascade)
  corretor    Corretor        @relation(fields: [corretor_id], references: [id], onDelete: Cascade)

  segundos_assistidos Int             @default(0)  // posição p/ "continuar de onde parou"
  percentual          Int             @default(0)  // 0–100
  status              StatusProgresso @default(nao_iniciado)
  concluido_em        DateTime?
  ultimo_acesso       DateTime        @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([aula_id, corretor_id])
  @@index([corretor_id])
  @@map("aula_progressos")
}

// ─── Modelos Visuais (editor estilo Canva) ──────────────────────

enum TipoModelo {
  credenciamento
  cracha
  certificado
}

model ModeloVisual {
  id          String     @id @default(uuid())
  nome        String
  descricao   String     @default("")
  tipo        TipoModelo
  largura     Int        // px do canvas
  altura      Int        // px do canvas
  canvas_json Json?      // serialização do Fabric.js
  ativo       Boolean    @default(true)

  eventos     EventoModelo[]

  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@index([tipo])
  @@map("modelos_visuais")
}

// Vínculo de um modelo a um evento (no máximo um por tipo por evento).
model EventoModelo {
  id        String       @id @default(uuid())
  evento_id String
  modelo_id String
  tipo      TipoModelo
  evento    Evento       @relation(fields: [evento_id], references: [id], onDelete: Cascade)
  modelo    ModeloVisual @relation(fields: [modelo_id], references: [id], onDelete: Cascade)
  created_at DateTime    @default(now())

  @@unique([evento_id, tipo])
  @@index([modelo_id])
  @@map("evento_modelos")
}

// Registro de documentos visuais gerados (credenciamento/crachá/certificado).
model DocumentoVisualGerado {
  id           String     @id @default(uuid())
  evento_id    String
  modelo_id    String?
  inscricao_id String?
  corretor_id  String?
  tipo         TipoModelo
  formato      String     // png | pdf | zip
  gerado_por   String?    // id do admin/operador
  created_at   DateTime   @default(now())

  @@index([evento_id])
  @@index([corretor_id])
  @@map("documentos_visuais_gerados")
}

// Modelos de mensagem salvos (reuso no Disparo em massa).
model ModeloMensagem {
  id         String   @id @default(uuid())
  nome       String
  assunto    String?  // assunto sugerido para e-mail
  conteudo   String   // texto da mensagem (aceita {nome})
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("modelos_mensagem")
}

// Disparo em massa agendado para uma data/hora futura (executado por cron).
model DisparoAgendado {
  id             String    @id @default(uuid())
  mensagem       String
  assunto        String?
  canal_whatsapp Boolean   @default(true)
  canal_email    Boolean   @default(false)
  corretor_ids   String[]
  anexo_base64   String?   // anexo opcional embutido (base64)
  anexo_nome     String?
  anexo_mime     String?
  agendado_para  DateTime
  status         String    @default("pendente") // pendente | enviado | erro | cancelado
  resultado      String?   // resumo do envio (ex.: "WhatsApp 12 · E-mail 8")
  erro           String?
  enviado_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([status, agendado_para])
  @@map("disparos_agendados")
}

// ─── Log de Auditoria (ações dos administradores) ────────────────

model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String?  // quem executou (null = sistema)
  admin_nome  String   // snapshot do nome (legível mesmo se o admin for removido)
  acao        String   // criou | editou | excluiu | status | enviou | importou | aprovou
  entidade    String   // corretor | imobiliaria | evento | usuario | inscricao | certificado | importacao
  entidade_id String?
  label       String?  // descrição legível do alvo (nome do corretor, título do evento…)
  detalhe     String?  // texto opcional com mais contexto

  created_at  DateTime @default(now())

  @@index([entidade])
  @@index([acao])
  @@index([created_at])
  @@map("audit_logs")
}

// ─── Configurações do Sistema (linha única / singleton) ──────────

model Configuracao {
  id               String   @id @default("singleton")
  empresa_nome     String   @default("IDIBRA")
  empresa_email    String   @default("")
  empresa_telefone String   @default("")
  empresa_site     String   @default("")
  auto_approve     Boolean  @default(true)   // aprovar corretores automaticamente no cadastro
  notify_inscricao Boolean  @default(true)   // notificar inscrição
  allow_cancel     Boolean  @default(true)   // permitir cancelamento pelo corretor
  updated_at       DateTime @updatedAt @default(now())

  @@map("configuracoes")
}

// ─── Templates de Mensagens (Central de Notificações) ────────────

model MensagemTemplate {
  id                String   @id @default(uuid())
  tipo              String   @unique  // evento_novo | lembrete_antecedencia | lembrete_dia | inscricao_confirmada | aprovacao | checkin | cancelamento_evento
  titulo            String              // nome amigável exibido no admin
  descricao         String              // quando dispara
  conteudo          String              // texto com {{placeholders}}
  ativo             Boolean  @default(true)
  com_imagem        Boolean  @default(false) // envia o banner do evento junto (quando aplicável)
  dias_antecedencia Int?                // usado apenas em lembrete_antecedencia
  updated_at        DateTime @updatedAt @default(now())

  @@map("mensagem_templates")
}

// ─── Reset de Senha ──────────────────────────────────────────────

model PasswordReset {
  id         String   @id @default(uuid())
  email      String   // e-mail do admin ou corretor (login é unificado)
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
  @@map("password_resets")
}
