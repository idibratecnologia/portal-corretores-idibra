# ─────────────────────────────────────────────────────────────────
# BACKEND — API REST IDIBRA (Fastify + Prisma na VPS)
# Copie para backend/.env e preencha com seus valores reais.
# NUNCA commite o .env com valores reais.
# ─────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Banco de Dados (PostgreSQL) ────────────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
DATABASE_URL=postgresql://idibra:SuaSenhaSegura@localhost:5432/idibra_db

# ── Autenticação (JWT) ─────────────────────────────────────────────
# Mínimo 32 caracteres — gere com: openssl rand -hex 32
JWT_SECRET=substitua-por-uma-chave-super-secreta-com-32-chars-minimo
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── Upload de Arquivos ─────────────────────────────────────────────
# Diretório absoluto onde os uploads serão salvos na VPS
UPLOAD_DIR=/var/www/uploads
# Tamanho máximo por arquivo em MB
UPLOAD_MAX_SIZE_MB=10
# URL pública base para acessar os arquivos (via Nginx)
API_URL=https://api.corretoridibra.com.br

# ── Evolution API (WhatsApp) ───────────────────────────────────────
# URL interna do container Docker (não expor publicamente)
EVOLUTION_URL=http://localhost:8080
# API Key configurada ao subir o container
EVOLUTION_API_KEY=sua-api-key-aqui
# Nome da instância criada no Evolution API (ex: "idibra")
EVOLUTION_INSTANCE=idibra
# Throttle da fila de envios (ms). O atraso entre mensagens varia entre min e max
# (jitter), reduzindo o risco de bloqueio do número pela Meta em disparos em massa.
WHATSAPP_MIN_DELAY_MS=4000
WHATSAPP_MAX_DELAY_MS=9000

# ── CORS ───────────────────────────────────────────────────────────
# Origins permitidas, separadas por vírgula.
# A 1ª origem https é usada como URL do portal nos links das mensagens.
ALLOWED_ORIGINS=https://corretoridibra.com.br,https://www.corretoridibra.com.br
